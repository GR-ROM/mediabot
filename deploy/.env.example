# Copy to .env beside this file and fill in. .env is gitignored; this is not.
#
#   cp deploy/.env.example deploy/.env && docker compose -f deploy/compose.yml up -d --build

# From BotFather. Everything else works without one; the chat does not.
MEDIABOT_TG_TOKEN=
MEDIABOT_TG_USERNAME=

# What the person reading the chat will click, so it must be an address their phone can reach —
# the host's own, not localhost, and the port below is the published one.
MEDIABOT_LINK_BASE=http://example.test:1488
MEDIABOT_PUBLIC_PORT=1488

# Who may administer the bot. Kept out of the database so an empty table cannot lock you out.
MEDIABOT_OWNERS=
# Seed for the allowed_chats table, written once when the table is first created. After that the
# table is the truth and /allow is how somebody gets in.
MEDIABOT_ALLOWED_CHATS=

# Where the served files and the queue live on the host.
MEDIABOT_DATA=/opt/mediabot

# Below this a result goes into the chat as a file; above it, as a link. 50 MB is the public
# Bot API's ceiling for an upload.
MEDIABOT_SEND_FILE_UNDER=52428800
MEDIABOT_PER_CHAT_LIMIT=8

# The tallest anybody may ask for, by who is asking.
MEDIABOT_MAX_HEIGHT=720
MEDIABOT_OWNER_MAX_HEIGHT=2160

# An OpenAI-compatible endpoint, used only for phrasings the grammar cannot read. The bot starts
# and works without it. If it sits behind basic auth, put the whole header value here.
MEDIABOT_LLM_URL=
MEDIABOT_AUTH_HEADER=

# YouTube refuses most videos without a signed-in session. Export cookies.txt and mount it.
MEDIABOT_COOKIES=
